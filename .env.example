FNO_ROUTER_IP=192.168.1.1
FNO_INTERVAL=60
# 0 = sem limpeza automática por idade
FNO_RETENTION_DAYS=0
# Gere um token aleatorio longo, nao publique no repositorio.
FNO_INGEST_TOKEN=

# Por padrão, somente localhost pode ler/escrever (inclusive com --bind 0.0.0.0).
# Defina APENAS sub-redes RFC1918 confiáveis, separadas por vírgula, se necessário.
# Isto é uma ACL de IP, NÃO login ou criptografia; protege melhor com VPN/TLS.
FNO_READ_ALLOW_CIDRS=

# Defesa contra DNS rebinding: nomes DNS confiáveis e explícitos usados no Host.
# Acesso por IPv4 privado literal/localhost não precisa dessa variável.
# Não adicionar domínio externo que terceiros consigam controlar.
FNO_ALLOWED_HOSTS=
